# SANITIZED FRAGMENT — example.com and public identifiers are illustrative.

{
    admin off
    auto_https disable_redirects
}

http://app.example.com {
    encode zstd gzip
    reverse_proxy application:8080
}

# Representative internal-TLS route used for an approved internal service path.
git.example.com {
    tls internal
    reverse_proxy forgejo:3000
}
